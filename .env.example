DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/taxaura
ENVIRONMENT=development
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
MAX_UPLOAD_SIZE_MB=10
MAX_DOCUMENTS_PER_USER=50
UPLOAD_DIRECTORY=storage/uploads
DOCUMENT_WORKER_ENABLED=true
WORKER_POLL_SECONDS=3
# Local Chroma works without a server; first use downloads the MiniLM embedding model.
CHROMA_MODE=local
CHROMA_DIRECTORY=storage/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
# extractive returns labeled sources; ollama generates answers from sources.
AI_MODE=extractive
AI_TIMEOUT_SECONDS=45
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
TESSERACT_CMD=
