DATABASE_URL=postgresql+asyncpg://taxaura:taxaura_local@postgres:5432/taxaura
# Gemini is server-side only. Leave empty for source excerpts without generation.
GEMINI_API_KEY=
# Required by existing authentication; generate with the README command.
JWT_SECRET_KEY=replace-this-with-a-long-random-secret

# Optional; Gemini model and embedding cache have safe backend defaults.
GEMINI_MODEL=gemini-3.8-flash
